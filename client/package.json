{
  "name": "@cee/client",
  "description": "Web-App und Desktop-App (Tauri 2) – Arbeitsfläche, Knoten-Editor, Textprojektion (ADR-031, ADR-035)",
  "version": "0.0.1",
  "license": "MPL-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run",
    "kern:build": "node tools/kern-build.mjs",
    "kern:bindctl": "node tools/bindctl-node.mjs",
    "kern:bindctl-browser": "node tools/bindctl-browser.mjs",
    "ui:snapshot": "node -e \"console.log('ui:snapshot: folgt mit der Arbeitsfläche (Playwright, hell und dunkel)')\"",
    "ui:perf": "node -e \"console.log('ui:perf: folgt mit der Arbeitsfläche')\""
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "playwright": "1.64.1",
    "prettier": "^3.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
