"""Typen der PyO3-Erweiterung `cee_sdk._graph` (crates/graph-py). JSON an der Grenze als Text."""

def units() -> str: ...
def parse(text: str, default: str | None = None) -> str: ...
def convert(value: float, from_: str, to: str, /) -> float: ...
def packages() -> str: ...
def call(name: str, doc: Doc, args: str) -> str: ...
def debug_panic() -> None: ...

class Doc:
    @staticmethod
    def new() -> Doc: ...
    @staticmethod
    def import_project(project: str, types: str | None = None) -> Doc: ...
    @staticmethod
    def load(data: bytes, types: str | None = None) -> Doc: ...
    def import_info(self) -> str: ...
    def save(self) -> bytes: ...
    def apply_op(self, op: str) -> str: ...
    def apply(self, ops: str) -> str: ...
    def export(self) -> str: ...
    def hash(self) -> str: ...
    def merge(self, other: Doc) -> None: ...
    def validate(self) -> str: ...
    def order(self) -> str: ...
    def affected(self, ids: str) -> str: ...
    def subgraph(self, id: str) -> str: ...
    def migrate(self) -> str: ...
    def element(self, id: str) -> str: ...
    def materialized_count(self) -> int: ...

class States:
    @staticmethod
    def new(doc: Doc) -> States: ...
    def event(self, event: str) -> None: ...
    def ready(self) -> str: ...
    def get(self) -> str: ...
